---
/**
 * The shared shell: head (meta/OG/JSON-LD), top bar, press strip, footer.
 * Every page renders inside this. Ported from the old src/layout.html.
 */
import { getSettings, ogImage, hoursData, jsonLd } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** which top-nav item is highlighted */
  nav?: 'home' | 'menu' | 'events' | 'photos' | 'bookings';
  /** the page's file name, e.g. "menu.html" — empty for the home page */
  page?: string;
}

const { title, description, nav, page = '' } = Astro.props;
const s = await getSettings();
const pageUrl = s.url + (page === 'index.html' ? '' : page);
const year = new Date().getFullYear();
const active = (n: string) => (nav === n ? 'active' : undefined);
---

<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Favicon (inline SVG, no external file needed) -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23a7bd1c'/%3E%3Ctext x='50' y='78' font-family='Arial Black,sans-serif' font-weight='900' font-size='80' fill='%23241710' text-anchor='middle'%3ER%3C/text%3E%3C/svg%3E">

<!-- Open Graph / Social sharing -->
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={pageUrl}>
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content={s.name}>
<meta property="og:image" content={ogImage(s)}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${s.name} — coffee, cake & a proper natter. Hempshaw Lane, Stockport.`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage(s)}>

<link rel="apple-touch-icon" href="./assets/icon.svg">
<link rel="manifest" href="./site.webmanifest">
<link rel="sitemap" href="./sitemap-index.xml">

<link rel="preload" href="./assets/fonts/bagelfatone.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="./assets/fonts/baloo2.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="./assets/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin>

<link rel="stylesheet" href="./styles.css">

<!-- LocalBusiness structured data (helps Google Search & Maps). -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd(s)).replace(/</g, '\\u003c')} />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<!-- TOP BAR -->
<header class="topbar">
  <a class="logo" href="./">{s.name}</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
  <label for="nav-toggle" class="burger" aria-label="Open menu" title="Menu" tabindex="0" role="button" aria-expanded="false" aria-controls="nav-toggle">
    <span></span><span></span><span></span>
  </label>
  <nav>
    <a href="./" class={active('home')}>Home</a>
    <a href="./menu.html" class={active('menu')}>Menu</a>
    <a href="./events.html" class={active('events')}>Events</a>
    <a href="./photos.html" class={active('photos')}>Photos</a>
    <a href="./bookings.html" class={active('bookings')}>Bookings</a>
    <a href="index.html#visit">Visit</a>
  </nav>
  <div class="status" data-open-status title="Opening hours">
    <span class="pulse"></span><span class="status-text">{s.statusShort}</span>
  </div>
</header>

<main id="main">
<slot />
</main>

{s.press.length > 0 && (
  <aside class="press" aria-label="As featured in">
    <span class="press-label">As featured in</span>
    <ul class="press-list">
      {s.press.map((p) => (
        <li><a href={p.url} target="_blank" rel="noopener">{p.name} ↗</a></li>
      ))}
    </ul>
  </aside>
)}

<!-- FOOTER -->
<footer>
  <p class="foot-addr">407 Hempshaw Lane</p>
  <div class="wordmark">{s.name}<em>.</em></div>
  <nav class="foot-nav">
    <a href="./">Home</a>
    <a href="./menu.html">Menu</a>
    <a href="./events.html">Events</a>
    <a href="./photos.html">Photos</a>
    <a href="./bookings.html">Bookings</a>
  </nav>
  <div class="socials">
    <a href={`mailto:${s.email}`}>Email</a>
    <a href={s.instagram} target="_blank" rel="noopener">Instagram</a>
    <a href={s.facebook} target="_blank" rel="noopener">Facebook</a>
  </div>
  <div class="small">© {year} {s.name} · {s.street} · {s.locality} {s.postcode} · Made with love &amp; espresso · Ranny's x 💚</div>
</footer>

<!-- Opening-hours data (read by the app script for the live open/closed status) -->
<script is:inline set:html={`window.__RANNYS__=${JSON.stringify(hoursData(s))};`} />
<script src="../scripts/app.ts"></script>

</body>
</html>
