---
import Site from '../layouts/Site.astro';
import RHead from '../components/RHead.astro';
import RCta from '../components/RCta.astro';
import RGallery from '../components/RGallery.astro';
import { getEntry } from 'astro:content';
import { getSettings } from '../lib/site';
import { pic } from '../lib/img';

const s = await getSettings();
const m = (await getEntry('menu', 'main'))!.data;
---

<Site title={`Menu — ${s.name}`} description={`The ${s.name} menu — proper coffee, cake and the good stuff. ${s.locality}.`} nav="menu" page="menu.html">

<section class="band r-page-head">
  <div class="r-wrap">
    <RHead kicker="The menu" level={1}>What's <em>on.</em><Fragment slot="lede">{m.intro}</Fragment></RHead>
    <p class="r-note">{m.note}</p>
  </div>
</section>

<section class="band band-alt">
  <div class="r-wrap">
    <p class="r-tip">Tap a photo to see it bigger.</p>
    <RGallery photos={m.cards} layout="even" sizes="(min-width: 900px) 25vw, 50vw" />
  </div>
</section>

<section class="band" id="special">
  <div class="r-wrap r-split">
    <figure class="r-frame r-special-photo r-reveal"><img {...pic(m.special.image, '(min-width: 900px) 45vw, 100vw')} alt={`${m.special.name}, an iced pistachio latte`} loading="lazy" decoding="async"></figure>
    <RHead kicker="House special">{m.special.name}<em>.</em><Fragment slot="lede">{m.special.blurb}</Fragment></RHead>
  </div>
</section>

<RCta kicker="Come in" text={`We're on ${s.street}, ${s.locality}. Kettle's on.`} href="/#visit" label="Find us">Come and <em>try it.</em></RCta>

</Site>
