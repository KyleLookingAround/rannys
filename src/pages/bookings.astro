---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { getSettings, mapEmbedUrl, directionsUrl } from '../lib/site';

const s = await getSettings();
const bookingsEntry = await getEntry('bookings', 'main');
if (!bookingsEntry) throw new Error('content/bookings.yml is missing');
const b = bookingsEntry.data;

const enquiryMailto = `mailto:${s.email}?subject=Booking%20enquiry%20%E2%80%94%20${encodeURIComponent(s.name)}&body=Hi%2C%0A%0AI%27d%20like%20to%20enquire%20about%20a%20booking%3A%0A%0A%E2%80%94%20What%20for%3A%20%0A%E2%80%94%20Date%2Ftime%3A%20%0A%E2%80%94%20Rough%20numbers%3A%20%0A%E2%80%94%20Anything%20else%3A%20%0A%0AThanks%21`;
---

<Base title={`Bookings — ${s.name}`} description={`Book the space at ${s.name} for your group. ${s.locality}.`} nav="bookings" page="bookings.html">

<!-- PAGE HEADER -->
<section class="page-head">
  <div class="page-head-grid">
    <div>
      <div class="eyebrow">Bookings</div>
      <h1 class="page-title">Have the <em>place.</em></h1>
      <p class="page-lede">{b.intro}</p>
    </div>
  </div>
</section>

<!-- WHAT YOU CAN BOOK -->
<section class="inside">
  <h2>What you can <em>book.</em></h2>
  <div class="cards">
    {b.bookingTypes.map((t, i) => (
      <div class="card">
        <div class="card-num">№ 0{i + 1}</div>
        <h3>{t.title}</h3>
        <p>{t.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- HOW IT WORKS + ENQUIRE -->
<section class="visit">
  <div class="visit-inner">
    <div>
      <div class="visit-label">How it works</div>
      <h2>Drop us the <em>details.</em></h2>
      <p class="booking-copy">No forms, no faff. Tell us what you're after — date, rough numbers, what you'd like — and we'll come straight back to you. We'll be honest about what works and what doesn't.</p>
      <ul class="contact-list">
        <li><span class="lbl">Email</span><a href={`mailto:${s.email}`}>{s.email}</a></li>
        <li><span class="lbl">Social</span><a href={s.instagram} target="_blank" rel="noopener">{s.instagramHandle}</a></li>
        <li><span class="lbl">Find us</span><span style="font-size:18px;">{s.street}, {s.postcode}</span></li>
      </ul>
      <a class="btn" href={enquiryMailto}>Send a booking enquiry</a>
    </div>
    <div class="map-col">
      <div class="map-card">
        <iframe
          src={mapEmbedUrl(s)}
          width="100%" height="100%"
          style="border:0; display:block;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${s.name} on ${s.street}, ${s.locality}`}
          allowfullscreen></iframe>
      </div>
      <a class="map-link" href={directionsUrl(s)} target="_blank" rel="noopener">Get directions →</a>
    </div>
  </div>
</section>

</Base>
