---
import Site from '../layouts/Site.astro';
import RHead from '../components/RHead.astro';
import { getEntry } from 'astro:content';
import { getSettings } from '../lib/site';

const s = await getSettings();
const b = (await getEntry('bookings', 'main'))!.data;
const mailto = `mailto:${s.email}?subject=${encodeURIComponent(`Booking enquiry — ${s.name}`)}`;
---

<Site title={`Bookings — ${s.name}`} description={`Book ${s.name} for private hire, group meet-ups and celebrations.`} nav="bookings" page="bookings.html">

<section class="band r-page-head">
  <div class="r-wrap">
    <RHead kicker="Bookings" level={1}>Have the <em>place.</em><Fragment slot="lede">{b.intro}</Fragment></RHead>
  </div>
</section>

<section class="band band-alt">
  <div class="r-wrap">
    <RHead kicker="What you can book">Pick your <em>do.</em></RHead>
    <ol class="r-numbered r-numbered-3">
      {b.bookingTypes.map((t) => <li><h3 class="r-h3">{t.title}</h3><p>{t.body}</p></li>)}
    </ol>
  </div>
</section>

<section class="band" id="enquire">
  <div class="r-wrap r-split">
    <div>
      <RHead kicker="Ask us">
        Tell us what you're <em>after.</em>
        <Fragment slot="lede">Fill this in and your email app opens with it all written out, ready to send. We'll come straight back to you and be honest about what works.</Fragment>
      </RHead>
      <p>Or email <a href={mailto}>{s.email}</a>, or message us on <a href={s.instagram} target="_blank" rel="noopener">Instagram</a>.</p>
    </div>
    <form class="r-form r-panel" data-enquiry={s.email}>
      <label for="enq-type">What's it for?</label>
      <select id="enq-type" name="type">
        {b.bookingTypes.map((t) => <option>{t.title}</option>)}
        <option>Something else</option>
      </select>
      <div class="r-form-row">
        <div><label for="enq-date">Date</label><input id="enq-date" name="date" type="date"></div>
        <div><label for="enq-people">How many people?</label><input id="enq-people" name="people" type="number" min="1" inputmode="numeric"></div>
      </div>
      <label for="enq-details">Anything else?</label>
      <textarea id="enq-details" name="details" rows="4" placeholder="Times, food, cake, the occasion…"></textarea>
      <label for="enq-name">Your name</label>
      <input id="enq-name" name="name" autocomplete="name">
      <button class="r-btn" type="submit">Write my email</button>
      <p class="enq-done" hidden>Your email app should have opened with this written out. If it didn't, email <a href={mailto}>{s.email}</a>.</p>
    </form>
  </div>
</section>

</Site>
