---
import Site from '../layouts/Site.astro';
import RHead from '../components/RHead.astro';
import { getEntry } from 'astro:content';
import { getSettings, mapEmbedUrl, directionsUrl, statusShort, eventPill } from '../lib/site';
import { pic, full } from '../lib/img';
import { hoursWithDays } from '../lib/hours';

const s = await getSettings();
const h = (await getEntry('home', 'main'))!.data;
const m = (await getEntry('menu', 'main'))!.data;
const g = (await getEntry('gallery', 'main'))!.data;
const ev = (await getEntry('events', 'main'))!.data;

// The next three events, swipeable on phones. A few spares are built in: the
// page script drops any that have passed since the last rebuild and shows the
// first three left, so the row stays right between rebuilds.
const SHOW = 3;
const today = new Date().toISOString().slice(0, 10);
const upcoming = [...ev.events]
  .sort((a, b) => a.date.localeCompare(b.date))
  .filter((e) => e.date >= today)
  .slice(0, SHOW + 3)
  .map((e) => ({ ...e, ...eventPill(e.date) }));

const rows = hoursWithDays(s);
const heroPhoto = g.photos.find((p) => p.src.includes('storefront')) ?? g.photos[0];
const teaser = g.photos.filter((p) => p !== heroPhoto).slice(0, 6);
const listMailto = `mailto:${s.email}?subject=Add%20me%20to%20the%20${encodeURIComponent(s.name)}%20list`;
const rowSizes = '(min-width: 900px) 280px, (min-width: 640px) 40vw, 72vw';
---

<Site title={`${s.name} — coffee, cake & a proper natter`} description={s.description} nav="home" page="">

<!-- HERO: the shop, whether it's open, and how to get there -->
<section class="band r-hero">
  <div class="r-hero-wrap">
    <div class="r-hero-grid">
      <figure class="r-hero-photo">
        <img {...pic(heroPhoto.src, '(min-width: 900px) 56vw, 100vw')} alt={heroPhoto.caption} fetchpriority="high" decoding="async">
      </figure>
      <div class="r-hero-card r-panel">
        <p class="r-kicker">{h.eyebrow}</p>
        <h1 class="r-hero-sign"><img src="/assets/ranny-sign.webp" alt={s.name} width="919" height="231"></h1>
        <p class="r-hero-line">Coffee, cake <span>&amp;</span> a proper natter.</p>
        <div class="r-today" data-open-status>
          <span class="pulse"></span>
          <div>
            <p class="r-today-main"><span class="status-text">{statusShort(s)}</span> <span class="of-sub"></span></p>
            <p class="r-today-sub"><span data-today-hours>Hours below</span> · {s.street}</p>
          </div>
        </div>
        <div class="r-actions">
          <a class="r-btn" href={directionsUrl(s)} target="_blank" rel="noopener">Get directions</a>
          <a class="r-btn r-btn-ghost" href="/menu.html">See the menu</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- COMING UP: the next three events, swipeable on phones -->
{upcoming.length > 0 && (
  <section class="band band-alt" data-next data-show={SHOW}>
    <div class="r-wrap">
      <RHead kicker="What's on" more={{ href: '/events.html', label: 'All events' }}>Coming <em>up.</em></RHead>
      <div class="r-scroller r-scroller-events" tabindex="0" aria-label="Upcoming events">
        {upcoming.map((e, i) => (
          <article class={`r-ev-card r-tile${i === 0 ? ' is-next' : ''}${e.soldOut ? ' is-sold-out' : ''}`} data-date={e.dateISO} hidden={i >= SHOW}>
            <a class="r-ev-card-poster" href="/events.html" tabindex="-1" aria-hidden="true">
              {e.soldOut && <span class="r-stamp">Sold out</span>}
              {e.poster
                ? <img {...pic(e.poster, '(min-width: 900px) 360px, (min-width: 640px) 44vw, 78vw')} alt="" loading="lazy" decoding="async">
                : <span class="r-ev-card-blank"><b>{e.day}</b>{e.month}</span>}
            </a>
            <div class="r-ev-card-body">
              <p class="r-date"><b>{e.day}</b> {e.month}<span class="r-pill">Next up</span></p>
              <h3 class="r-event-title"><a href="/events.html">{e.title}</a></h3>
              <p class="r-when">{e.when}</p>
              {e.soldOut
                ? <p class="r-sold-note"><span class="sold-out">Sold out</span> <a class="r-link" href="/events.html">More about this&nbsp;→</a></p>
                : e.link
                  ? <a class="r-link" href={e.link} target="_blank" rel="noopener">{e.linkText || 'Details'}&nbsp;↗</a>
                  : <a class="r-link" href="/events.html">More about this&nbsp;→</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ON THE BOARD -->
<section class="band">
  <div class="r-wrap">
    <RHead kicker="The menu" more={{ href: '/menu.html', label: 'Full menu' }}>
      On the <em>board.</em>
      <Fragment slot="lede">{m.intro}</Fragment>
    </RHead>
    <div class="r-scroller" tabindex="0" aria-label="Menu photos">
      {m.cards.map((c, i) => (
        <a class="r-card-photo r-tile r-reveal" href={`/menu.html#shot-${i + 1}`}>
          <img {...pic(c.src, rowSizes)} alt={c.alt} loading="lazy" decoding="async">
          <span class="r-cap">{c.caption}</span>
        </a>
      ))}
    </div>
    <a class="r-special r-reveal" href="/menu.html#special">
      <img {...pic(m.special.image, '88px')} alt="" loading="lazy" decoding="async">
      <span><small>House special</small><b>{m.special.name}</b>{m.special.blurb}</span>
    </a>
  </div>
</section>

<!-- STORY -->
<section class="band band-alt r-story">
  <div class="r-wrap r-split">
    <figure class="r-frame r-reveal"><img {...pic('/assets/story.jpg', '(min-width: 900px) 45vw, 100vw')} alt="Rhianne outside the freshly-painted Ranny's, pointing up at the new sign before opening" loading="lazy" decoding="async"></figure>
    <div class="r-prose">
      <RHead kicker="The story">Hi, I'm <em>{h.story.name}.</em></RHead>
      <p class="r-lede">{h.story.lede}</p>
      <p>{h.story.paragraphs[0]}</p>
      {h.story.paragraphs.length > 1 && (
        <details class="r-disclose">
          <summary>Read the rest</summary>
          <div class="r-prose">{h.story.paragraphs.slice(1).map((p) => <p>{p}</p>)}</div>
        </details>
      )}
      <p class="r-sign-off">{h.story.signature}</p>
    </div>
  </div>
</section>

<!-- WHAT YOU'LL FIND -->
<section class="band band-olive">
  <div class="r-wrap">
    <RHead kicker="Inside">What you'll <em>find.</em></RHead>
    <ol class="r-numbered r-numbered-3">
      {h.inside.map((it) => <li class="r-reveal"><h3 class="r-h3">{it.title}</h3><p>{it.body}</p></li>)}
    </ol>
  </div>
</section>

<!-- PHOTOS -->
<section class="band">
  <div class="r-wrap">
    <RHead kicker="The place" more={{ href: '/photos.html', label: 'All photos' }}>Have a <em>nosey.</em></RHead>
    <div class="r-scroller r-scroller-photos" tabindex="0" aria-label="Photos of the shop">
      {teaser.map((p) => (
        <a class="r-card-photo r-tile r-reveal" href={`/photos.html#shot-${g.photos.indexOf(p) + 1}`}>
          <img {...pic(p.src, '(min-width: 900px) 360px, (min-width: 640px) 40vw, 72vw')} alt={p.caption} loading="lazy" decoding="async">
          <span class="r-cap">{p.caption}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- QUOTE -->
<section class="band r-quote" style={`--bg: url('${full(h.quote.image)}')`}>
  <blockquote>
    <p>{h.quote.text}</p>
    <cite>{h.quote.by}</cite>
  </blockquote>
</section>

<!-- MADE ROUND HERE: suppliers + local makers -->
<section class="band band-alt">
  <div class="r-wrap r-split r-split-rev">
    <div>
      <RHead kicker="Made round here">
        Who's <em>behind it.</em>
        <Fragment slot="lede">{h.localArt.blurb}</Fragment>
      </RHead>
      <ul class="r-credits">
        {h.partners.map((p) => (
          <li><span>{p.category}</span>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}&nbsp;↗</a> : <b>{p.name}</b>}</li>
        ))}
        {h.localCredits.map((c) => (
          <li><span>{c.role}</span>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}&nbsp;↗</a> : <b>{c.name}</b>}</li>
        ))}
      </ul>
    </div>
    <figure class="r-frame r-reveal">
      <img {...pic(h.localArt.image, '(min-width: 900px) 40vw, 100vw')} alt="Framed watercolour of the Ranny's shopfront by Sketch Stockport, hung on the shop wall" loading="lazy" decoding="async">
      <figcaption>{h.localArt.caption}</figcaption>
    </figure>
  </div>
</section>

<!-- BOOK + LIST -->
<section class="band r-duo">
  <div class="band-burnt">
    <RHead kicker="Got a group?">Hire out <em>Ranny's.</em><Fragment slot="lede">{h.community.blurb}</Fragment></RHead>
    <a class="r-btn" href="/bookings.html">Ask about a booking</a>
  </div>
  <div class="band-walnut">
    <RHead kicker="On the list">Know what's <em>on.</em><Fragment slot="lede">{h.mailingList.blurb}</Fragment></RHead>
    <a class="r-btn" href={listMailto}>Join the list</a>
  </div>
</section>

<!-- VISIT -->
<section class="band" id="visit">
  <div class="r-wrap r-split">
    <div>
      <RHead kicker="Come say hi">
        Find <em>us.</em>
        <Fragment slot="lede">{`${s.name}, ${s.street}, ${s.locality} ${s.postcode}`}</Fragment>
      </RHead>
      <table class="r-hours">
        <caption><span class="r-kicker">Opening hours</span></caption>
        <tbody>
          {rows.map((r) => <tr data-days={r.days}><th scope="row">{r.day}</th><td>{r.time}</td></tr>)}
        </tbody>
      </table>
      <div class="r-actions">
        <a class="r-btn" href={directionsUrl(s)} target="_blank" rel="noopener">Get directions</a>
        <a class="r-btn r-btn-ghost" href={`mailto:${s.email}`}>Email us</a>
      </div>
    </div>
    <div class="r-map">
      <iframe src={mapEmbedUrl(s)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${s.name} on ${s.street}, ${s.locality}`} allowfullscreen></iframe>
    </div>
  </div>
</section>

</Site>
