---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getEntry } from 'astro:content';
import { getSettings, mapEmbedUrl, directionsUrl } from '../lib/site';

const s = await getSettings();
const homeEntry = await getEntry('home', 'main');
if (!homeEntry) throw new Error('content/home.yml is missing');
const h = homeEntry.data;
const galleryEntry = await getEntry('gallery', 'main');
if (!galleryEntry) throw new Error('content/gallery.yml is missing');
const teaserPhotos = galleryEntry.data.photos.slice(0, 6);

const listMailto = `mailto:${s.email}?subject=Add%20me%20to%20the%20${encodeURIComponent(s.name)}%20list&body=Hi%2C%0A%0APop%20me%20on%20the%20list%20please.%0A%0AThanks%21`;
---

<Base title={`${s.name} — coffee, cake & a proper natter`} description={s.description} nav="home" page="index.html">

<!-- HERO -->
<section class="hero">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">{h.eyebrow}</div>
      <h1>
        <span class="lime-bg">Coffee,</span><br>
        cake <span class="amp">&amp;</span><br>
        a proper<br>
        natter.
      </h1>
      <p class="hero-tag">{h.tagline}</p>

      <div class="hero-meta">
        <div>Open<span>{s.hoursShort}</span></div>
        <div>Find us<span>{s.street}</span></div>
        <div>Postcode<span>{s.postcode}</span></div>
      </div>

      <div class="open-flag" data-open-status>
        <span class="pulse"></span>
        <span class="status-text">{s.statusShort}</span>
        <span class="of-sub"></span>
      </div>
    </div>

    <figure class="hero-art">
      <img src="./assets/storefront-illustration.jpg" alt="Illustration of the Ranny's shopfront — green frontage at 407 Hempshaw Lane, with coffee and shop signs in the windows" loading="eager" width="1600" height="1439">
      <figcaption>407 Hempshaw Lane</figcaption>
    </figure>
  </div>
</section>

<!-- TODAY'S SPECIALS TICKER -->
<div class="ticker" aria-label="Today at Ranny's">
  <div class="ticker-tag">Today</div>
  <div class="ticker-track">
    {h.marquee.map((item) => <span>{item}</span>)}
    {h.marquee.map((item) => <span>{item}</span>)}
  </div>
</div>

<!-- STORY -->
<section class="story" id="story">
  <div class="story-inner">
    <div>
      <div class="story-label">01 — The Story</div>
      <h2>Hi, I'm <em>{h.story.name}</em>.</h2>
      <figure class="story-photo">
        <img src="./assets/story.jpg" alt="Rhianne outside the freshly-painted Ranny's, pointing up at the new sign before opening" loading="lazy">
      </figure>
    </div>
    <div>
      <p class="lede">{h.story.lede}</p>
      {h.story.paragraphs.map((p) => <p>{p}</p>)}
      <div class="signature">{h.story.signature}</div>
    </div>
  </div>
</section>

<!-- INSIDE -->
<section class="inside" id="inside">
  <h2>What you'll find <em>inside.</em></h2>
  <div class="cards">
    <div class="card">
      <div class="card-num">№ 01</div>
      <svg class="card-icon" aria-hidden="true" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M10 28h32v14a8 8 0 0 1-8 8H18a8 8 0 0 1-8-8V28z"/>
        <path d="M42 32h6a6 6 0 0 1 0 12h-6"/>
        <path d="M18 10c0 4 4 4 4 8s-4 4-4 8"/><path d="M28 10c0 4 4 4 4 8s-4 4-4 8"/><path d="M38 10c0 4 4 4 4 8s-4 4-4 8"/>
      </svg>
      <h3>{h.inside[0].title}</h3>
      <p>{h.inside[0].body}</p>
    </div>
    <div class="card">
      <div class="card-num">№ 02</div>
      <svg class="card-icon" aria-hidden="true" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M10 22 L30 12 L50 22 L50 26 L10 26 Z"/><path d="M14 26 L14 48 L46 48 L46 26"/>
        <path d="M20 32 L40 32"/><path d="M18 40 L42 40"/><circle cx="30" cy="18" r="2" fill="currentColor"/>
      </svg>
      <h3>{h.inside[1].title}</h3>
      <p>{h.inside[1].body}</p>
    </div>
    <div class="card">
      <div class="card-num">№ 03</div>
      <svg class="card-icon" aria-hidden="true" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M14 26 C 14 18, 46 18, 46 26 L46 42 C46 48, 14 48, 14 42 Z"/><ellipse cx="30" cy="26" rx="16" ry="4"/>
        <path d="M22 14 C22 10, 24 8, 26 10"/><path d="M30 12 C30 8, 32 6, 34 8"/><path d="M38 14 C38 10, 40 8, 42 10"/>
      </svg>
      <h3>{h.inside[2].title}</h3>
      <p>{h.inside[2].body}</p>
    </div>
  </div>
</section>

<!-- GALLERY TEASER (tap a photo to see the lot) -->
<section class="gallery" id="gallery">
  <div class="gallery-head">
    <div class="section-eyebrow">The Place</div>
    <h2>Have a <em>nosey.</em></h2>
  </div>
  <Gallery photos={teaserPhotos} mode="teaser" />
  <p class="gallery-more"><a class="btn" href="./photos.html">See all the photos</a></p>
</section>

<!-- FEATURED QUOTE BAND (her photo + a line in her voice) -->
<section class="quote-band" style={`background-image: url('${h.quote.image}')`}>
  <div class="quote-overlay"></div>
  <blockquote class="quote">
    <p>{h.quote.text}</p>
    <cite>{h.quote.by} <span aria-hidden="true">💚</span></cite>
  </blockquote>
</section>

<!-- SUPPLIERS -->
<section class="partners" id="partners">
  <div class="partners-inner">
    <div class="partners-label">02 — In Good Company</div>
    <h2>From our <em>suppliers.</em></h2>
    <div class="partners-grid">
      {h.partners.map((p) => (
        <div class="partner">
          <span class="partner-cat">{p.category}</span>
          <h3>{p.url
            ? <a class="partner-link" href={p.url} target="_blank" rel="noopener">{p.name} ↗</a>
            : p.name}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MADE LOCAL — credits the local artists & makers -->
<section class="made-local" id="made-local">
  <div class="made-local-inner">
    <figure class="ml-art">
      <img src={h.localArt.image} alt="Framed watercolour of the Ranny's shopfront by local artist Sketch Stockport, hung on the shop wall" loading="lazy">
      <figcaption>{h.localArt.caption}</figcaption>
    </figure>
    <div class="ml-text">
      <div class="section-eyebrow">By local hands</div>
      <h2>Made <em>local.</em></h2>
      <p class="lede">{h.localArt.blurb}</p>
      <ul class="ml-credits">
        {h.localCredits.map((c) => (
          <li>
            <span class="ml-role">{c.role}</span>
            <span class="ml-name">{c.url
              ? <a class="ml-link" href={c.url} target="_blank" rel="noopener">{c.name} ↗</a>
              : c.name}</span>
            <span class="ml-note">{c.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- COMMUNITY (teaser → bookings) -->
<section class="community" id="community">
  <div class="community-inner">
    <div class="eyebrow">Got a group?</div>
    <h2>Hire out <em>Rannys.</em></h2>
    <p>{h.community.blurb}</p>
    <a class="btn" href="./bookings.html">See bookings</a>
  </div>
</section>

<!-- MAILING LIST -->
<section class="signup" id="notify">
  <div class="signup-inner">
    <div class="eyebrow">On the list</div>
    <h2>Know what's <em>on.</em></h2>
    <p class="lede">{h.mailingList.blurb}</p>
    {h.mailingList.action
      ? <form class="signup-form" action={h.mailingList.action} method="post" target="_blank">
          <input class="signup-input" type="email" name={h.mailingList.fieldName} placeholder="you@email.com" required aria-label="Email address">
          <button class="btn btn-signup" type="submit">Join the list</button>
        </form>
      : <a class="btn btn-signup" href={listMailto}>Join the list</a>}
    <p class="signup-fineprint">No spam. No nonsense. Just the good stuff.</p>
  </div>
</section>

<!-- VISIT -->
<section class="visit" id="visit">
  <div class="visit-inner">
    <div>
      <div class="visit-label">03 — Come Say Hi</div>
      <h2>Find us on {s.street}.</h2>
      <div class="address">
        <strong>{s.name} Coffee Shop</strong>
        {s.street}<br>
        {s.locality}, {s.postcode}
      </div>
      <ul class="hours-list">
        {s.hours.map((hr) => <li><span class="hl-day">{hr.day}</span><span class="hl-time">{hr.time}</span></li>)}
      </ul>
      <ul class="contact-list">
        <li><span class="lbl">Email</span><a href={`mailto:${s.email}`}>{s.email}</a></li>
        <li><span class="lbl">Social</span><a href={s.instagram} target="_blank" rel="noopener">{s.instagramHandle}</a></li>
      </ul>
    </div>

    <div class="map-col">
      <div class="map-card">
        <iframe
          src={mapEmbedUrl(s)}
          width="100%" height="100%"
          style="border:0; display:block;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${s.name} on ${s.street}, ${s.locality}`}
          allowfullscreen></iframe>
      </div>
      <a class="map-link" href={directionsUrl(s)} target="_blank" rel="noopener">Get directions →</a>
    </div>
  </div>
</section>

<!-- CLOSING FLOURISH — the draggable 3D enamel mug -->
<section class="closer">
  <div class="closer-inner">
    <div class="mug-stage mug-stage--sm" data-mug hidden>
      <span class="mug-hint">drag to spin</span>
    </div>
    <p class="closer-line">Right then — <em>kettle's on.</em></p>
  </div>
</section>

</Base>
