---
import Site from '../layouts/Site.astro';
import RHead from '../components/RHead.astro';
import RCta from '../components/RCta.astro';
import RGallery from '../components/RGallery.astro';
import { getEntry } from 'astro:content';
import { getSettings } from '../lib/site';

const s = await getSettings();
const g = (await getEntry('gallery', 'main'))!.data;
---

<Site title={`Photos — ${s.name}`} description={`A look around ${s.name} on ${s.street}, ${s.locality}.`} nav="photos" page="photos.html">

<section class="band r-page-head">
  <div class="r-wrap">
    <RHead kicker="The place" level={1}>Have a <em>nosey.</em><Fragment slot="lede">{g.intro}</Fragment></RHead>
  </div>
</section>

<section class="band band-alt">
  <div class="r-wrap">
    <RGallery photos={g.photos} layout="collage" />
  </div>
</section>

<RCta kicker="Come in" text={`It looks even better with a brew in hand. We're on ${s.street}, ${s.locality}.`} href="/#visit" label="Find us">See it in <em>person.</em></RCta>

</Site>
