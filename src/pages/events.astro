---
import Site from '../layouts/Site.astro';
import RHead from '../components/RHead.astro';
import RCta from '../components/RCta.astro';
import { getEntry } from 'astro:content';
import { getSettings, eventPill } from '../lib/site';
import { pic, full } from '../lib/img';

const s = await getSettings();
const { intro, events } = (await getEntry('events', 'main'))!.data;
// soonest first; past ones fade then disappear (see shared.ts)
const list = [...events].sort((a, b) => a.date.localeCompare(b.date)).map((e) => ({ ...e, ...eventPill(e.date) }));
// the first upcoming one (as of the build) shows its poster large, the rest as thumbnails
const today = new Date().toISOString().slice(0, 10);
const firstUp = list.findIndex((e) => e.date >= today);
---

<Site title={`What's on — ${s.name}`} description={`What's on at ${s.name}, ${s.street}, ${s.locality}.`} nav="events" page="events.html">

<section class="band r-page-head">
  <div class="r-wrap">
    <RHead kicker="What's on" level={1}>Events at <em>Ranny's.</em><Fragment slot="lede">{intro}</Fragment></RHead>
  </div>
</section>

<section class="band band-alt">
  <div class="r-wrap">
    {list.length > 0 && (
      <ol class="event-list r-events">
        {list.map((e, i) => (
          <li class={`event r-tile${e.soldOut ? ' is-sold-out' : ''}`} data-date={e.dateISO}>
            {e.poster && (
              <a class="r-ev-poster" href={full(e.poster)} target="_blank" rel="noopener" aria-label={`Open the full poster for ${e.title}`}>
                {e.soldOut && <span class="r-stamp" aria-hidden="true">Sold out</span>}
                <img {...pic(e.poster, i === firstUp ? '(min-width: 640px) 280px, 360px' : '120px')} alt={`Poster for ${e.title}`} loading="lazy" decoding="async">
              </a>
            )}
            <div>
              <p class="r-date"><b>{e.day}</b> {e.month}<span class="r-pill">Next up</span></p>
              <h2 class="event-title r-event-title">{e.title}</h2>
              <p class="r-when">{e.when}</p>
              <div class="r-ev-actions">
                {e.soldOut
                  ? <span class="sold-out">Sold out</span>
                  : e.link && <a class="event-link r-btn" href={e.link} target="_blank" rel="noopener">{e.linkText || 'Details'}&nbsp;↗</a>}
                <details class="r-disclose">
                  <summary>More about this</summary>
                  <p class="r-ev-desc">{e.description}</p>
                </details>
              </div>
            </div>
          </li>
        ))}
      </ol>
    )}
    <p class="events-none r-lede" hidden={list.length > 0}>Nothing in the diary right now. Keep an eye on <a href={s.instagram} target="_blank" rel="noopener">Instagram</a> and we'll shout when something's on.</p>
  </div>
</section>

<RCta kicker="Got a group?" text="Book club, knit night, running crew, new-mum meet-up. If you've got the people, we've got the room and the cake." href="/bookings.html" label="Ask about a booking">Run your own <em>thing.</em></RCta>

</Site>
